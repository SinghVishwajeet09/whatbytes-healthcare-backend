                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Stephen Strange\",\n  \"specialization\": \"Chief of Neurosurgery\",\n  \"contact_number\": \"+1-555-8888\",\n  \"email\": \"dr.strange@sanctum-health.org\",\n  \"years_of_experience\": 15,\n  \"hospital_affiliation\": \"Metro General Hospital & Research\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            }
          }
        },
        {
          "name": "Delete Doctor Record",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/doctors/{{doctor_id}}/",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "{{doctor_id}}", ""]
            }
          }
        }
      ]
    },
    {
      "name": "4. Patient-Doctor Mappings",
      "item": [
        {
          "name": "Assign Doctor to Patient",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.mapping && jsonData.mapping.id) {",
                  "    pm.collectionVariables.set('mapping_id', jsonData.mapping.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patient\": 1,\n  \"doctor\": 2,\n  \"notes\": \"Assigned for specialized pediatric and neurological consultation\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "Retrieve All Patient-Doctor Mappings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/mappings/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", ""]
            }
          }
        },
        {
          "name": "Get All Doctors Assigned to Specific Patient",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/mappings/1/",
              "host": ["{{base_url}}"],
              "path": ["api", "mappings", "1", ""]
            }
          }
